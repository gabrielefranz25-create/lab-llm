# Configurazione dell'assistente. Copiare in .env (che resta fuori da Git) e completare.
# Nessuna credenziale: LM Studio non richiede chiavi.

# Indirizzo dell'API compatibile OpenAI di LM Studio (obbligatoria).
# In Docker viene sovrascritta da compose.yaml con http://host.docker.internal:1234/v1
LM_BASE_URL=http://localhost:1234/v1

# Identificativo del modello, copiato da GET /v1/models (obbligatoria).
LM_MODEL=ID_RESTITUITO_DA_GET_v1_models

# Fuso orario IANA usato quando l'utente non indica un luogo (facoltativa, default Europe/Rome).
FUSO_ORARIO_PREDEFINITO=Europe/Rome

# Massimo numero di giri di strumento per domanda (facoltativa, intero >= 1, default 3).
MAX_PASSI_STRUMENTO=3

# Messaggi della cronologia inviati al modello (facoltativa, intero >= 2, default 20).
MAX_MESSAGGI_CONTESTO=20

# Oltre MAX_MESSAGGI_CONTESTO la cronologia viene riassunta dal modello: restano il riassunto
# e gli ultimi MESSAGGI_DA_TENERE messaggi (facoltativa, intero >= 2 e < MAX_MESSAGGI_CONTESTO, default 6).
MESSAGGI_DA_TENERE=6

# Revisioni per domanda (lezione 6, step 2): se il revisore giudica la risposta incompleta o fuori tema
# la rimanda all'agente al massimo MAX_REVISIONI volte; 0 = il revisore giudica e registra soltanto
# (facoltativa, intero >= 0, default 2).
MAX_REVISIONI=2

# File JSON delle preferenze dell'utente (lingua, fuso_orario, stile: sintetico o dettagliato), esposto
# dal server MCP utente come resource utente://preferenze e letto dall'agente a inizio sessione
# (lezione 6, step 4; facoltativa, default server_mcp/risorse/preferenze.json, relativo a lab_llm/).
# Il fuso delle preferenze prevale su FUSO_ORARIO_PREDEFINITO, che resta il valore di riserva.
# PREFERENZE_FILE=server_mcp/risorse/preferenze.json

# Attesa massima di una risposta di LM Studio, in secondi (facoltativa, default 60).
LM_TIMEOUT=60

# Livello dei log: DEBUG, INFO, WARNING, ERROR (facoltativa, default INFO).
LOG_LEVEL=INFO

# Attesa massima, in secondi, per l'avvio di un server MCP (catalogo), per ogni sua chiamata e
# per la sua chiusura (facoltativa, default 30).
# Deve essere maggiore del doppio di METEO_TIMEOUT.
MCP_TIMEOUT=30

# Attesa massima di ogni richiesta HTTP del server meteo, in secondi (facoltativa, default 10).
METEO_TIMEOUT=10

# Percorso del file SQLite delle note (facoltativa, default dati/note.sqlite3).
NOTE_DB=dati/note.sqlite3

# Server MCP da avviare, separati da virgole (facoltativa, default: tutti).
# Se la variabile è presente ma vuota non parte nessun server.
# Nomi validi: meteo, note, unita, calcolatrice, scadenze, catalogo.
# SERVER_MCP=meteo,note,unita,calcolatrice,scadenze,catalogo

# Ambito dell'agente, in linguaggio naturale: il router rifiuta le domande che non vi rientrano
# (facoltativa; se assente l'ambito si compone da agente/config.py: ora e saluti più una frase
# per ogni server MCP attivo in SERVER_MCP).
# AMBITO_AGENTE=data e ora attuali, meteo, note personali dell'utente, saluti e domande sull'assistente

# Variante dell'orologio ora_corrente (lezione 5, blocco B), una sola attiva (facoltativa, default locale):
#   locale  = funzione Python nel processo dell'agente;
#   fastapi = wrapper HTTP verso il servizio FastAPI (avviarlo prima: python -m servizio_orologio.api);
#   mcp     = server FastMCP server_mcp/orologio.py, avviato dall'agente come gli altri server MCP.
VARIANTE_OROLOGIO=locale

# Indirizzo del servizio FastAPI dell'orologio, solo con VARIANTE_OROLOGIO=fastapi
# (facoltativa, default http://localhost:8001; in Docker la imposta compose.yaml).
# OROLOGIO_API_URL=http://localhost:8001

# Attesa massima di ogni richiesta al servizio orologio, in secondi (facoltativa, default 5).
# OROLOGIO_API_TIMEOUT=5

# Trasporto verso i server MCP (lezione 5, blocco C; facoltativa, default stdio):
#   stdio = l'agente avvia i server come sottoprocessi;
#   http  = l'agente si collega a server Streamable HTTP già avviati (python -m server_mcp.avvia_http),
#           all'indirizzo http://<MCP_HTTP_HOST>:<porta del server>/mcp (porte 8101-8107).
# TRASPORTO_MCP=stdio
# Host dei server HTTP (facoltativa, default 127.0.0.1; in Docker la imposta compose.yaml).
# MCP_HTTP_HOST=127.0.0.1

# Agente come servizio HTTP (lezione 6, step 6): python -m agente.servizio ascolta su
# AGENTE_ASCOLTO:AGENTE_PORTA (default 127.0.0.1:8000); la CLI client dell'API (python -m agente.cli)
# lo raggiunge su AGENTE_URL (default http://127.0.0.1:8000).
# AGENTE_ASCOLTO=127.0.0.1
# AGENTE_PORTA=8000
# AGENTE_URL=http://127.0.0.1:8000
