# Configurazione dell'assistente. Copiare in .env (che resta fuori da Git) e completare.
# Nessuna credenziale: LM Studio non richiede chiavi.

# Indirizzo dell'API compatibile OpenAI di LM Studio (obbligatoria).
# In Docker viene sovrascritta da compose.yaml con http://host.docker.internal:1234/v1
LM_BASE_URL=http://localhost:1234/v1

# Identificativo del modello, copiato da GET /v1/models (obbligatoria).
LM_MODEL=ID_RESTITUITO_DA_GET_v1_models

# Fuso orario IANA usato quando l'utente non indica un luogo (facoltativa, default Europe/Rome).
FUSO_ORARIO_PREDEFINITO=Europe/Rome

# Massimo numero di giri di strumento per domanda (facoltativa, intero >= 1, default 3).
MAX_PASSI_STRUMENTO=3

# Messaggi della cronologia inviati al modello (facoltativa, intero >= 2, default 20).
MAX_MESSAGGI_CONTESTO=20

# Oltre MAX_MESSAGGI_CONTESTO la cronologia viene riassunta dal modello: restano il riassunto
# e gli ultimi MESSAGGI_DA_TENERE messaggi (facoltativa, intero >= 2 e < MAX_MESSAGGI_CONTESTO, default 6).
MESSAGGI_DA_TENERE=6

# Attesa massima di una risposta di LM Studio, in secondi (facoltativa, default 60).
LM_TIMEOUT=60

# Livello dei log: DEBUG, INFO, WARNING, ERROR (facoltativa, default INFO).
LOG_LEVEL=INFO

# Attesa massima di una chiamata a un server MCP, in secondi (facoltativa, default 30).
# Deve essere maggiore del doppio di METEO_TIMEOUT.
MCP_TIMEOUT=30

# Attesa massima di ogni richiesta HTTP del server meteo, in secondi (facoltativa, default 10).
METEO_TIMEOUT=10

# Percorso del file SQLite delle note (facoltativa, default dati/note.sqlite3).
NOTE_DB=dati/note.sqlite3

# Server MCP da avviare, separati da virgole (facoltativa, default meteo).
# Se la variabile è presente ma vuota non parte nessun server.
# SERVER_MCP=meteo
